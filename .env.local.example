# Plantilla de .env.local para el desarrollo de Faro (ADR 0004, 0009 y 0012).
#
# 1. Copia este archivo como .env.local en la raíz del repositorio:
#      Copy-Item .env.local.example .env.local
# 2. El .env.local real NUNCA se versiona: está en .gitignore. No escribas aquí
#    ni en .env.local claves de proveedores de IA ni ningún otro secreto real.
# 3. Solo lo leen los builds de depuración (núcleo con debug_assertions y motor
#    con --dev). Los builds de release lo ignoran.
#
# Modo gestionado (por defecto, `npm run dev`): solo necesitas este archivo para
# FARO_ALLOW_LOCAL_SITES (al final).
# Modo externo (`npm run dev:engine` en una terminal + `npm run dev` en otra):
# descomenta FARO_ENGINE_DEV_URL y FARO_ENGINE_DEV_TOKEN. Si FARO_ENGINE_DEV_URL
# no está definida, el núcleo usa el modo gestionado.

# Puerto donde escucha el motor en modo externo (por defecto 8765).
FARO_ENGINE_DEV_PORT=8765

# URL del motor externo. Debe ser exactamente http://127.0.0.1:<puerto>.
# FARO_ENGINE_DEV_URL=http://127.0.0.1:8765

# Token de sesión de desarrollo: 43 caracteres base64url, generado por ti. Por ejemplo:
#   uv run --directory apps/engine python -c "import secrets; print(secrets.token_urlsafe(32))"
# FARO_ENGINE_DEV_TOKEN=<pega-aqui-el-token-generado>

# Base de datos de desarrollo (solo `npm run dev:engine`, ADR 0009). Nunca uses la llave
# ni los datos de tu perfil real. Se guarda en apps/engine/.devdata/ (ignorada por git).
# Sin estas dos variables el motor arranca con la base no disponible (db.key_missing).
#   Llave (64 hex):
#     uv run --directory apps/engine python -c "import secrets; print(secrets.token_hex(32))"
#   Perfil (UUID en minúsculas):
#     uv run --directory apps/engine python -c "from faro_engine.core.ids import new_id; print(new_id())"
# FARO_ENGINE_DEV_DB_KEY=<pega-aqui-la-llave-generada>
# FARO_ENGINE_DEV_PROFILE_ID=<pega-aqui-el-perfil-generado>

# Sitios locales para probar con wp-env (ADR 0012). SOLO DESARROLLO.
# Con 1, Faro acepta direcciones http:// en tu propia computadora (localhost, 127.0.0.1,
# ::1), por ejemplo el WordPress de wp-env en http://localhost:8888. Las redes privadas
# (192.168.x.x, 10.x.x.x…) siguen bloqueadas y el puerto del motor también.
# - `npm run dev` (modo gestionado): el núcleo lanza el motor con --allow-local-sites solo
#   si es un build de depuración y aquí (o en el entorno) hay exactamente 1.
# - `npm run dev:engine` (modo externo): el motor --dev lee este mismo valor.
# Nunca funciona en la app instalada: el núcleo de release no pasa el argumento y el motor
# empaquetado lo rechaza. Déjalo en 0 si no estás probando con wp-env.
FARO_ALLOW_LOCAL_SITES=0
