{
  "version": 1,
  "description": "Vectores de prueba de la firma v1 de Faro (ADR 0011 §2). Datos de prueba evidentes, no secretos reales. Los usan PHPUnit (packages/wp-plugin) y pytest (apps/engine); no se incluyen en el zip del plugin.",
  "algorithm": {
    "canonical": "METHOD \"\n\" ROUTE \"\n\" TIMESTAMP \"\n\" NONCE \"\n\" hex(sha256(body))",
    "route": "Ruta REST sin barra final. Si hay parámetros de consulta distintos de rest_route: \"?\" + pares rawurlencode(clave) \"=\" rawurlencode(valor) (RFC 3986: solo A-Z a-z 0-9 - _ . ~ sin codificar, hex en mayúsculas), ordenados por clave codificada y después por valor codificado, comparando bytes, unidos con \"&\". La consulta son los valores ya decodificados que recibe el servidor.",
    "signature": "base64 estándar (con relleno) de HMAC-SHA256 con clave = base64url_decode(hmac_secret) (32 bytes) sobre la canónica en UTF-8.",
    "headers": [
      "X-Faro-Connection",
      "X-Faro-Token",
      "X-Faro-Timestamp",
      "X-Faro-Nonce",
      "X-Faro-Signature"
    ]
  },
  "cases": [
    {
      "name": "status_sin_cuerpo",
      "description": "GET /status sin consulta ni cuerpo.",
      "hmac_secret": "dGVzdC1mYXJvLWhtYWMtc2VjcmV0LW5vdC1yZWFsLTE",
      "method": "GET",
      "route": "/faro/v1/status",
      "query": {},
      "body": "",
      "timestamp": "1790000000",
      "nonce": "dGVzdC1ub25jZS0wMDAwMQ",
      "expected_canonical_route": "/faro/v1/status",
      "expected_canonical": "GET\n/faro/v1/status\n1790000000\ndGVzdC1ub25jZS0wMDAwMQ\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "expected_signature": "lwcDEveNvVxpbsIUkfZ9t2PIDF+PZvOcZzKlmAFbr/c="
    },
    {
      "name": "posts_paginacion",
      "description": "GET /posts con page y per_page (el orden de entrada no importa).",
      "hmac_secret": "dGVzdC1mYXJvLWhtYWMtc2VjcmV0LW5vdC1yZWFsLTE",
      "method": "GET",
      "route": "/faro/v1/posts",
      "query": {
        "per_page": "50",
        "page": "2"
      },
      "body": "",
      "timestamp": "1790000100",
      "nonce": "dGVzdC1ub25jZS0wMDAwMg",
      "expected_canonical_route": "/faro/v1/posts?page=2&per_page=50",
      "expected_canonical": "GET\n/faro/v1/posts?page=2&per_page=50\n1790000100\ndGVzdC1ub25jZS0wMDAwMg\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "expected_signature": "5d4/zfCMTc/TsTfcpXblj23xa69sI2BjJAtdUYPeZT8="
    },
    {
      "name": "posts_barra_final",
      "description": "La barra final de la ruta se quita.",
      "hmac_secret": "dGVzdC1mYXJvLWhtYWMtc2VjcmV0LW5vdC1yZWFsLTE",
      "method": "GET",
      "route": "/faro/v1/posts/",
      "query": {
        "page": "1"
      },
      "body": "",
      "timestamp": "1790000200",
      "nonce": "dGVzdC1ub25jZS0wMDAwMw",
      "expected_canonical_route": "/faro/v1/posts?page=1",
      "expected_canonical": "GET\n/faro/v1/posts?page=1\n1790000200\ndGVzdC1ub25jZS0wMDAwMw\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "expected_signature": "xKEmPw0Dmit2E2DzpNzbnMf7CSO31raxF8I9GHUSt1c="
    },
    {
      "name": "orden_por_bytes",
      "description": "Varias claves: orden por clave codificada en bytes (mayúsculas antes que minúsculas).",
      "hmac_secret": "dGVzdC1mYXJvLWhtYWMtc2VjcmV0LW5vdC1yZWFsLTE",
      "method": "GET",
      "route": "/faro/v1/pages",
      "query": {
        "b": "1",
