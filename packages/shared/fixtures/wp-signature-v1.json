      "expected_canonical": "GET\n/faro/v1/products?empty=&filter=%C3%B1and%C3%BA%20%26%20co%2F%3F%3D%2B%25~%2A%27%28%29%21&page=1\n1790000400\ndGVzdC1ub25jZS0wMDAwNQ\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "expected_signature": "fXLHnhLDabNR2sTubMEhU9vO1uUWryvT1mw+cJlCAD0="
