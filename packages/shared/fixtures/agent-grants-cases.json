{
  "description": "Vectores compartidos de agent-grants.json (ADR 0014 §1): los usan scripts/generate-contracts.test.mjs y apps/engine/tests/agents/test_grants.py. Si cambias una regla, cámbiala en los dos y actualiza estos casos.",
  "version": 1,
  "rules": {
    "access": ["get"],
    "kind_pattern": "^[a-z][a-z0-9_]{1,47}$",
    "max_grant_seconds": 900,
    "min_grant_seconds": 60,
    "templates": [
      "llm/anthropic/default",
      "llm/gemini/default",
      "llm/openai/default",
      "wp/{site_id}/token"
    ]
  },
  "valid": [
    {
      "name": "registro vacío",
      "input": [],
      "expected": []
    },
    {
      "name": "site_summary con sus cuatro referencias (secrets se ordenan por ref)",
      "input": [
        {
          "kind": "site_summary",
          "requires_site": true,
          "max_grant_seconds": 900,
          "secrets": [
            {
              "ref": "wp/{site_id}/token",
              "access": ["get"]
            },
            {
              "ref": "llm/openai/default",
              "access": ["get"]
            },
            {
              "ref": "llm/gemini/default",
              "access": ["get"]
            },
            {
              "ref": "llm/anthropic/default",
              "access": ["get"]
            }
          ]
        }
      ],
      "expected": [
        {
          "kind": "site_summary",
          "requires_site": true,
          "max_grant_seconds": 900,
          "secrets": [
            {
              "ref": "llm/anthropic/default",
              "access": ["get"]
            },
            {
              "ref": "llm/gemini/default",
              "access": ["get"]
            },
            {
              "ref": "llm/openai/default",
              "access": ["get"]
            },
            {
              "ref": "wp/{site_id}/token",
              "access": ["get"]
            }
          ]
        }
      ]
    },
    {
      "name": "varios agentes se ordenan por kind; límites 60 y 900",
      "input": [
        {
          "kind": "zeta",
          "requires_site": false,
          "max_grant_seconds": 60,
          "secrets": [
            {
              "ref": "llm/openai/default",
              "access": ["get"]
            }
          ]
        },
        {
          "kind": "alfa",
          "requires_site": true,
          "max_grant_seconds": 900,
          "secrets": []
