{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "trailingComma": "all",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "apps/desktop/**",
      "options": {
        "tailwindStylesheet": "./apps/desktop/src/styles/globals.css",
        "tailwindFunctions": ["cn", "cva"]
      }
    },
    {
      "files": "*.md",
      "options": {
        "proseWrap": "never"
      }
    }
  ]
}
